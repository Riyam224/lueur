# ============================================================
# Miscellaneous
# ============================================================
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ============================================================
# Flutter/Dart/Pub related
# ============================================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ============================================================
# Secrets & credentials — never commit any of these
# ============================================================
.env
.env.*
!.env.example
env.json
*.env.json
secrets.dart
secrets.json
**/lib/**/secrets/**

# Signing / keystores
android/key.properties
android/*.jks
android/*.keystore
*.jks
*.keystore
*.p12
*.pem
*.mobileprovision
*.p8
*.cer
ios/**/*.p12
ios/**/*.mobileprovision

# Firebase config (client identifiers, still keep out of a public repo)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
macos/Runner/GoogleService-Info.plist
firebase-adminsdk*.json
firebase-service-account*.json
**/serviceAccountKey.json

# Sentry
sentry.properties
.sentryclirc

# Supabase / third-party constants that embed keys
lib/core/constants/supabase_constants.dart

# Any local override of API endpoints (staging/local URLs, tokens for testing)
lib/core/networking/api_endpoints_local.dart
lib/**/*_local.dart

# Fastlane (if/when used for App Store/Play automation)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
**/fastlane/.env
**/fastlane/Fastfile.local

# ============================================================
# Repo hygiene — not secrets, but shouldn't bloat a public repo
# ============================================================
screenshots/
specs/
*.checklists/
.claude/*
!.claude/settings.json
.skills/
.specs/
.specify/
.checklists/
.contracts/
.agents/
.speckit/
*.claude-session

# Crash dumps / device logs that may contain user data captured during debugging
*.crashlog
*.hprof
*.trace

# Local database dumps sometimes pulled for debugging (Hive boxes, sqlite)
*.hive
*.sqlite
*.db
